CAMERA_SOURCE=data/teste.mp4
CAMERA_ID=portaria-1
BACKEND_URL=http://localhost:3000
BACKEND_API_KEY=
MIN_CONFIDENCE=0.6
DEDUP_SECONDS=30
SAMPLE_INTERVAL_SECONDS=1.0
BACKEND_TIMEOUT=5
BACKEND_MAX_RETRIES=3
# fake = sem reconhecimento real (desenvolvimento); tf = detector e OCR Keras nossos;
# fpo = nosso detector + OCR pronto fast-plate-ocr (MIT). RECOMENDADO para uso real.
RECOGNITION_MODE=fake
# Modelo do fast-plate-ocr (modo fpo). Baixa na 1a execucao (precisa de internet); ver README.
FPO_MODEL=cct-s-v2-global-model
DETECTOR_MODEL_PATH=models/detector.keras
OCR_MODEL_PATH=models/ocr.keras
DETECTOR_THRESHOLD=0.5
# vazio = usa MIN_CONFIDENCE também no OCR. Com RECOGNITION_MODE=fpo, recomendado 0.95 (curva medida no RodoSol; provisório)
OCR_MIN_CONFIDENCE=
# Votação entre quadros (em quadros amostrados; com SAMPLE_INTERVAL_SECONDS=1.0, 3 quadros = ~3 s). Provisório.
VOTE_MAX_READS=3
VOTE_GAP_FRAMES=3
